    content/browser/vimbra/vimbra-tokens.css (themes/vimbra-tokens.css)
    content/browser/vimbra/vimbra-chrome.css (themes/vimbra-chrome.css)
    content/browser/vimbra/vimbra-pages.css (themes/vimbra-pages.css)
    content/browser/vimbra/fonts/Geist-latin.woff2 (themes/fonts/Geist-latin.woff2)
    content/browser/vimbra/fonts/Geist-latin-ext.woff2 (themes/fonts/Geist-latin-ext.woff2)
    content/browser/vimbra/fonts/GeistMono-latin.woff2 (themes/fonts/GeistMono-latin.woff2)
    content/browser/vimbra/fonts/GeistMono-latin-ext.woff2 (themes/fonts/GeistMono-latin-ext.woff2)
